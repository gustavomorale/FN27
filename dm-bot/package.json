{
  "name": "fn-dm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FN DM automation: Instagram comment-to-DM, Instagram DMs and WhatsApp with keyword flows and Claude fallback",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute fn-dm --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute fn-dm --local --file=schema.sql",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
